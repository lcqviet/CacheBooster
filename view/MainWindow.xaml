<Window x:Class="CacheBooster.view.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CacheBooster.viewmodel"
        xmlns:v="clr-namespace:CacheBooster.view"
        Title="CacheBooster" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">

	<!-- Gán HomeControl làm DataContext điều khiển MainWindow -->
	<Window.DataContext>
		<vm:HomeControl />
	</Window.DataContext>

	<Window.Resources>
		<!-- Ánh xạ ViewModel với View tương ứng -->
		<DataTemplate DataType="{x:Type vm:HomePageViewModel}">
			<v:HomePage />
		</DataTemplate>
	</Window.Resources>

	<Grid>
		<!-- Hiển thị tràn toàn bộ cửa sổ -->
		<ContentControl Content="{Binding CurrentView}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
	</Grid>
</Window>